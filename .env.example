# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
# Token obtenu via @BotFather sur Telegram (Obligatoire)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Taille maximale par fichier envoyé à Telegram (en octets)
# 50 MiB = 52428800 octets (limite stricte imposée par l'API Bot Telegram standard)
MAX_FILE_SIZE=52428800

# Nombre maximum de téléchargements simultanés au niveau global
MAX_CONCURRENT_DOWNLOADS=2

# Nombre maximum de téléchargements simultanés par utilisateur
MAX_CONCURRENT_DOWNLOADS_PER_USER=1

# Timeout d'un téléchargement en secondes (5 minutes par défaut)
DOWNLOAD_TIMEOUT=300

# Répertoire temporaire de travail pour isoler les téléchargements de chaque tâche
# Note pour hébergements mutualisés / PaaS (Alwaysdata, etc.) :
# /tmp est généralement monté en tmpfs (RAM). Pour éviter de saturer la RAM (OOM / SIGKILL -9),
# définissez TEMP_DIR dans un dossier de votre disque (ex: ./tmp/telegram-downloader ou ~/tmp)
TEMP_DIR=/tmp/telegram-downloader

# Résolution maximale pour les vidéos téléchargées en mode Scinder / Haute Qualité (par défaut: 1080)
# Sur petits serveurs (100-256 Mo RAM), vous pouvez définir MAX_VIDEO_HEIGHT=720 pour économiser la bande passante et la RAM.
# MAX_VIDEO_HEIGHT=1080

# Niveau de journalisation (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Chemin du fichier JSON de suivi et d'historique des téléchargements (par défaut: downloads_history.json)
# DOWNLOAD_HISTORY_FILE=downloads_history.json

# Chemin binaire optionnel pour yt-dlp et gallery-dl (par défaut: résolution automatique via PATH)
# YTDLP_BIN=/usr/local/bin/yt-dlp
# GALLERYDL_BIN=/usr/local/bin/gallery-dl

# Authentification optionnelle (pour Stories Instagram, contenus privés ou protégés) :
# Option 1 : Fichier cookies Netscape exporté depuis votre navigateur
# COOKIES_FILE=/chemin/vers/cookies.txt
# Option 2 : Extraction directe depuis un navigateur installé (chrome, firefox, safari, brave, edge)
# COOKIES_BROWSER=chrome


# # 1. Créer un dossier bin dans votre home et y télécharger ffmpeg statique
# mkdir -p ~/bin && cd ~/bin
# wget https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz
# tar -xf ffmpeg-release-amd64-static.tar.xz --strip-components=1 
# rm ffmpeg-release-amd64-static.tar.xz 
  
# # 2. Vérifier que ffmpeg fonctionne
# ~/bin/ffmpeg -version 
  
# Ensuite, indiquez le chemin à votre bot dans son fichier .env :
     
# FFMPEG_BIN=/home/testeur/bin/ffmpeg


  
# 1. Sur votre navigateur (Chrome ou Firefox) :
#     • Connectez-vous à Facebook (idéalement avec un compte secondaire ou jetable).                                                                                      
#     • Installez l'extension open-source Get cookies.txt LOCALLY https://chromewebstore.google.com/detail/get-cookiestxt-locally/cclelndahbckbenkjhflpdbgdldlbecc (ou    
#     équivalent Firefox).
#     • Cliquez sur l'extension sur l'onglet Facebook et exportez le fichier au format Netscape (ex : facebook_cookies.txt).
# 2. Dans le projet MediaDownloaderBot :
#     • Placez ce fichier dans le dossier du bot (ou un dossier sécurisé), par exemple :
#       /Users/emery.toss/Downloads/Workspace/apps/MediaDownloaderBot/facebook_cookies.txt

# Cookies pour Facebook (optionnel, pour les contenus privés ou protégés)
COOKIES_FILE=/Users/emery.toss/Downloads/Workspace/apps/MediaDownloaderBot/facebook_cookies.txt